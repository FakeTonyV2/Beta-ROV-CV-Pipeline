[Unit]
Description=Purdue ROV CV camera service (%i)
After=network.target purdue-cv-broker.service

[Service]
Type=simple
ExecStart=/opt/purdue-rov-cv/.venv/bin/purdue-cv-camera --camera %i --config /etc/purdue-rov-cv/mission.yaml
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
