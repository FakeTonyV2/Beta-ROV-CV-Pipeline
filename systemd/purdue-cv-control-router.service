[Unit]
Description=Purdue ROV CV control router
Wants=network-online.target
After=network-online.target chrony.service purdue-cv-broker.service
Requires=purdue-cv-broker.service
PartOf=purdue-cv-onboard.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=purdue-cv
Group=purdue-cv
SupplementaryGroups=video
ExecStart=/opt/purdue-rov-cv/.venv/bin/purdue-cv-control-router --config /etc/purdue-rov-cv/mission.yaml
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillSignal=SIGTERM
RestartPreventExitStatus=78
RuntimeDirectory=purdue-rov-cv
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=purdue-rov-cv

[Install]
WantedBy=purdue-cv-onboard.target
