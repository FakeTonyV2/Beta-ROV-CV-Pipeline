[Unit]
Description=Purdue ROV CV control router
Wants=network-online.target
After=network-online.target chronyd.service purdue-cv-broker.service
Requires=purdue-cv-broker.service

[Service]
Type=simple
ExecStart=/opt/purdue-rov-cv/.venv/bin/purdue-cv-control-router --config /etc/purdue-rov-cv/mission.yaml
Restart=on-failure
RestartSec=1
TimeoutStopSec=5
RuntimeDirectory=purdue-rov-cv
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
