[Unit]
Description=Purdue ROV CV surface system health
Wants=network-online.target chrony.service
After=network-online.target chrony.service
PartOf=purdue-cv-surface.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=purdue-cv
Group=purdue-cv
SupplementaryGroups=video
ExecStart=/opt/purdue-rov-cv/.venv/bin/purdue-cv-surface-health --config /etc/purdue-rov-cv/mission.yaml
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
KillSignal=SIGTERM
RestartPreventExitStatus=78
RuntimeDirectory=purdue-rov-cv
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=purdue-rov-cv

[Install]
WantedBy=purdue-cv-surface.target
