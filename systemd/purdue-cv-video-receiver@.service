[Unit]
Description=Purdue ROV CV surface video receiver (%i)
After=network-online.target purdue-cv-broker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/purdue-rov-cv/.venv/bin/purdue-cv-video-receiver --camera %i --config /etc/purdue-rov-cv/mission.yaml
Restart=on-failure
RestartSec=1
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
